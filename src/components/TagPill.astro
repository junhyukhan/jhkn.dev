---
const { tag, size = "sm" } = Astro.props;

const config = {
    sm: "px-2 py-1 text-sm",
    base: "px-3 py-2 text-base",
};

const classes = config[size as keyof typeof config] || config.sm;
---

<a
    href={`/notes?tags=${tag}`}
    class={`inline-block font-mono text-gray-500 bg-gray-50 border border-gray-200 rounded-md hover:bg-gray-100 hover:text-gray-700 transition-all duration-150 no-underline ${classes}`}
>
    #{tag}
</a>
