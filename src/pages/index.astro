---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import WritingListItem from "../components/WritingListItem.astro";

const pageTitle = "JHKN.DEV";
const allWriting = await getCollection("writing");
const recentWriting = allWriting
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<BaseLayout pageTitle={pageTitle}>
    <section class="mb-16">
        <h1 class="text-3xl font-bold mb-4">
            Hello. I am a software engineer building AI platforms and tinkering
            with home labs.
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
            I write about what I learn. Mostly Go, TypeScript, and
            infrastructure.
        </p>
    </section>

    <section>
        <div class="flex justify-between items-baseline mb-8">
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-500">
                Recent Writing
            </h2>
            <a
                href="/writing"
                class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors"
            >
                View all &rarr;
            </a>
        </div>

        <ul class="space-y-6">
            {recentWriting.map((post) => <WritingListItem post={post} />)}
        </ul>
    </section>
</BaseLayout>
