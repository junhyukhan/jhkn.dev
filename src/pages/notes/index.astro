---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { groupNotesByTopic, getSortedGroupKeys } from "../../utils/noteGrouping";
import { getNoteTitle } from "../../utils/note";

const pageTitle = "Notes";
const allNotes = await getCollection("notes");

const groupedNotes = groupNotesByTopic(allNotes);
const sortedKeys = getSortedGroupKeys(groupedNotes);
---

<BaseLayout pageTitle={pageTitle}>
	<section class="mb-12">
		<h1 class="text-3xl font-bold mb-4">Notes</h1>
		<p class="mb-8 text-gray-600">
			A collection of raw thoughts, snippets, and learnings. These are
			less polished than blog posts and more like a digital garden.
		</p>

		<div class="space-y-6">
			{
				sortedKeys.map((key) => (
					<section>
						<span class="font-mono text-xs text-gray-400 uppercase tracking-wider">
							{groupedNotes[key].displayName}
						</span>
						<ul class="font-mono text-sm space-y-1 mt-2">
							{groupedNotes[key].notes.map((note) => (
								<li>
									<a href={`/${note.collection}/${note.slug}/`} class="flex items-baseline group">
										<span class="text-gray-400 mr-4 shrink-0">
											{note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : ""}
										</span>
										<span class="group-hover:underline text-blue-600">
											{getNoteTitle(note)}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>
