---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildGraphData } from "../utils/graph";

const allNotes = await getCollection("notes");
const graphData = buildGraphData(allNotes);
---

<BaseLayout pageTitle="Graph" wide={true}>
  <div class="relative">
    <div class="flex items-baseline justify-between mb-4">
      <h1 class="text-2xl font-bold tracking-tight">Graph</h1>
      <div id="graph-legend" class="flex gap-4 font-mono text-xs text-gray-400">
        <span class="flex items-center gap-1">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#3b82f6"></span>
          General
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#f59e0b"></span>
          LeetCode
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#22c55e"></span>
          Quotes
        </span>
      </div>
    </div>

    <div id="graph-tooltip"
      class="hidden absolute z-10 bg-white border border-gray-200 rounded-lg shadow-lg px-3 py-2 text-sm"
      style="width: 200px;">
    </div>

    <div id="graph-container" class="border border-gray-200 rounded-lg overflow-hidden bg-gray-50"
      style="height: 70vh;">
      <canvas id="graph-canvas" style="touch-action: none;"></canvas>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />

<script>
  import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide } from "d3-force";

  const graphData = JSON.parse(document.getElementById("graph-data")!.textContent!);

  const GROUP_COLORS: Record<string, string> = {
    general: "#3b82f6",
    leetcode: "#f59e0b",
    quotes: "#22c55e",
  };
  const DEFAULT_COLOR = "#94a3b8";

  function escapeHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  // --- Canvas setup ---
  const container = document.getElementById("graph-container")!;
  const canvas = document.getElementById("graph-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const tooltip = document.getElementById("graph-tooltip")!;

  const dpr = window.devicePixelRatio || 1;
  let width = container.clientWidth;
  let height = container.clientHeight;

  function resizeCanvas() {
    width = container.clientWidth;
    height = container.clientHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = width + "px";
    canvas.style.height = height + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resizeCanvas();

  // --- Transform state (zoom + pan) ---
  let transform = { x: 0, y: 0, k: 1 };

  function toWorld(sx: number, sy: number): [number, number] {
    return [(sx - transform.x) / transform.k, (sy - transform.y) / transform.k];
  }

  // --- Graph data ---
  interface SimNode {
    id: string;
    slug: string;
    title: string;
    group: string;
    tags: string[];
    linkCount: number;
    x?: number;
    y?: number;
    vx?: number;
    vy?: number;
    fx?: number | null;
    fy?: number | null;
    index?: number;
  }
  interface SimLink {
    source: SimNode | string;
    target: SimNode | string;
  }

  const nodes: SimNode[] = graphData.nodes.map((n: any) => ({ ...n }));
  const links: SimLink[] = graphData.links.map((l: any) => ({ ...l }));

  function nodeRadius(d: SimNode): number {
    return Math.min(8 + d.linkCount * 2, 24);
  }

  // Non-linear zoom compensation: partially counter-scales visual sizes
  // so elements stay readable when zoomed out and don't bloat when zoomed in.
  // Screen-size scales as k^0.35 instead of k^1.
  function compensate(): number {
    return 1 / Math.pow(transform.k, 0.65);
  }

  // --- Simulation ---
  const simulation = forceSimulation(nodes as any)
    .force("link", forceLink(links as any).id((d: any) => d.id).distance(100).strength(0.3))
    .force("charge", forceManyBody().strength(-250))
    .force("center", forceCenter(width / 2, height / 2))
    .force("collide", forceCollide().radius((d: any) => nodeRadius(d) + 3))
    .on("tick", draw);

  // --- Hover state ---
  let hoveredNode: SimNode | null = null;
  let connectedIds: Set<string> | null = null;

  function getConnected(node: SimNode): Set<string> {
    const ids = new Set<string>([node.id]);
    for (const link of links) {
      const s = (link.source as SimNode).id;
      const t = (link.target as SimNode).id;
      if (s === node.id) ids.add(t);
      if (t === node.id) ids.add(s);
    }
    return ids;
  }

  // --- Drawing ---
  function draw() {
    ctx.save();
    ctx.clearRect(0, 0, width, height);
    ctx.translate(transform.x, transform.y);
    ctx.scale(transform.k, transform.k);

    const dimmed = hoveredNode !== null;
    const c = compensate();

    // Draw links
    for (const link of links) {
      const s = link.source as SimNode;
      const t = link.target as SimNode;
      const isHighlighted = dimmed && connectedIds!.has(s.id) && connectedIds!.has(t.id);

      ctx.beginPath();
      ctx.moveTo(s.x!, s.y!);
      ctx.lineTo(t.x!, t.y!);
      if (dimmed && !isHighlighted) {
        ctx.strokeStyle = "rgba(0,0,0,0.04)";
        ctx.lineWidth = 1 * c;
      } else if (isHighlighted) {
        ctx.strokeStyle = GROUP_COLORS[hoveredNode!.group] || DEFAULT_COLOR;
        ctx.lineWidth = 2.5 * c;
      } else {
        ctx.strokeStyle = "rgba(0,0,0,0.15)";
        ctx.lineWidth = 1.5 * c;
      }
      ctx.stroke();
    }

    // Draw nodes
    for (const node of nodes) {
      const r = nodeRadius(node) * c;
      const color = GROUP_COLORS[node.group] || DEFAULT_COLOR;
      const isHovered = hoveredNode === node;
      const isConnected = dimmed && connectedIds!.has(node.id);

      ctx.beginPath();
      ctx.arc(node.x!, node.y!, isHovered ? r * 1.3 : r, 0, Math.PI * 2);

      if (dimmed && !isConnected) {
        ctx.fillStyle = color + "20";
      } else {
        ctx.fillStyle = color;
      }
      ctx.fill();

      if (isHovered) {
        ctx.strokeStyle = color;
        ctx.lineWidth = 2 * c;
        ctx.stroke();
      }

      // Show more labels when zoomed in
      const hubThreshold = transform.k > 1.5 ? 2 : 5;
      const showLabel = node.linkCount >= hubThreshold || isHovered || (dimmed && isConnected);
      if (showLabel) {
        const fontSize = Math.max(10, Math.min(12, 9 + node.linkCount * 0.3)) * c;
        ctx.font = `${fontSize}px system-ui, -apple-system, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        ctx.fillStyle = dimmed && !isConnected ? "rgba(0,0,0,0.1)" : "rgba(0,0,0,0.7)";
        ctx.fillText(node.title, node.x!, node.y! + r + 4 * c);
      }
    }

    ctx.restore();

    // Keep tooltip anchored to the hovered node's screen position
    if (hoveredNode && !tooltip.classList.contains("hidden")) {
      const sx = hoveredNode.x! * transform.k + transform.x;
      const sy = hoveredNode.y! * transform.k + transform.y;
      positionTooltip(sx, sy);
    }
  }

  // --- Find node under cursor ---
  function findNode(mx: number, my: number): SimNode | null {
    const [wx, wy] = toWorld(mx, my);
    const c = compensate();
    for (let i = nodes.length - 1; i >= 0; i--) {
      const node = nodes[i];
      const r = nodeRadius(node) * c + 2;
      const dx = wx - node.x!;
      const dy = wy - node.y!;
      if (dx * dx + dy * dy < r * r) return node;
    }
    return null;
  }

  // --- Shared tooltip logic ---
  const TOOLTIP_W = 200;
  const TOOLTIP_GAP = 12;

  function positionTooltip(sx: number, sy: number) {
    const cw = container.clientWidth;
    const ch = container.clientHeight;
    const th = tooltip.offsetHeight || 80;

    // Flip horizontally if it would overflow right
    let left = sx + TOOLTIP_GAP;
    if (left + TOOLTIP_W > cw) {
      left = sx - TOOLTIP_GAP - TOOLTIP_W;
    }
    left = Math.max(4, Math.min(left, cw - TOOLTIP_W - 4));

    // Clamp vertically
    let top = sy - 10;
    top = Math.max(4, Math.min(top, ch - th - 4));

    tooltip.style.left = left + "px";
    tooltip.style.top = top + "px";
  }

  function showTooltip(node: SimNode, screenX: number, screenY: number) {
    const tags = node.tags.length ? node.tags.map(escapeHtml).join(", ") : "none";
    tooltip.innerHTML = `
      <a href="/notes/${node.slug}/" class="font-medium text-gray-900 hover:underline">${escapeHtml(node.title)}</a>
      <div class="text-gray-400 text-xs font-mono mt-1">${node.linkCount} connections · ${escapeHtml(node.group)}</div>
      <div class="text-gray-400 text-xs font-mono">tags: ${tags}</div>
    `;
    tooltip.classList.remove("hidden");
    positionTooltip(screenX, screenY);
  }

  function hideTooltip() {
    tooltip.classList.add("hidden");
    hoveredNode = null;
    connectedIds = null;
    draw();
  }

  // --- Mouse interaction ---
  let dragNode: SimNode | null = null;
  let panStart: { x: number; y: number; tx: number; ty: number } | null = null;

  canvas.addEventListener("mousemove", (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    if (dragNode) {
      const [wx, wy] = toWorld(mx, my);
      dragNode.fx = wx;
      dragNode.fy = wy;
      simulation.alpha(0.3).restart();
      return;
    }

    if (panStart) {
      transform.x = panStart.tx + (mx - panStart.x);
      transform.y = panStart.ty + (my - panStart.y);
      draw();
      return;
    }

    const node = findNode(mx, my);
    if (node !== hoveredNode) {
      hoveredNode = node;
      connectedIds = node ? getConnected(node) : null;
      canvas.style.cursor = node ? "pointer" : "grab";

      if (node) {
        showTooltip(node, mx, my);
      } else {
        if (!tooltip.matches(":hover")) {
          tooltip.classList.add("hidden");
        }
      }
      draw();
    } else if (node) {
      positionTooltip(mx, my);
    }
  });

  canvas.addEventListener("mousedown", (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    const node = findNode(mx, my);

    if (node) {
      dragNode = node;
      const [wx, wy] = toWorld(mx, my);
      node.fx = wx;
      node.fy = wy;
      simulation.alphaTarget(0.3).restart();
    } else {
      panStart = { x: mx, y: my, tx: transform.x, ty: transform.y };
      canvas.style.cursor = "grabbing";
    }
  });

  canvas.addEventListener("mouseup", () => {
    if (dragNode) {
      dragNode.fx = null;
      dragNode.fy = null;
      simulation.alphaTarget(0);
    }
    dragNode = null;
    panStart = null;
    canvas.style.cursor = hoveredNode ? "pointer" : "grab";
  });

  // --- Zoom ---
  canvas.addEventListener("wheel", (e) => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    const factor = e.deltaY < 0 ? 1.1 : 0.9;
    const newK = Math.max(0.2, Math.min(5, transform.k * factor));
    const ratio = newK / transform.k;

    transform.x = mx - ratio * (mx - transform.x);
    transform.y = my - ratio * (my - transform.y);
    transform.k = newK;

    draw();
  }, { passive: false });

  // --- Hide tooltip when mouse leaves canvas or tooltip ---
  canvas.addEventListener("mouseleave", () => {
    if (!tooltip.matches(":hover")) hideTooltip();
  });

  tooltip.addEventListener("mouseleave", () => {
    canvas.style.cursor = "grab";
    hideTooltip();
  });

  // --- Touch interaction ---
  let touchDragNode: SimNode | null = null;
  let touchPanStart: { x: number; y: number; tx: number; ty: number } | null = null;
  let pinchStart: { dist: number; k: number; mx: number; my: number } | null = null;
  let touchStartPos: { x: number; y: number } | null = null;

  function getTouchPos(e: TouchEvent, index = 0): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    return {
      x: e.touches[index].clientX - rect.left,
      y: e.touches[index].clientY - rect.top,
    };
  }

  function pinchDist(e: TouchEvent): number {
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }

  function pinchMid(e: TouchEvent): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    return {
      x: (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left,
      y: (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top,
    };
  }

  canvas.addEventListener("touchstart", (e) => {
    e.preventDefault();

    if (e.touches.length === 2) {
      // Start pinch zoom
      touchDragNode = null;
      touchPanStart = null;
      const mid = pinchMid(e);
      pinchStart = { dist: pinchDist(e), k: transform.k, mx: mid.x, my: mid.y };
      return;
    }

    if (e.touches.length === 1) {
      pinchStart = null;
      const pos = getTouchPos(e);
      touchStartPos = { x: pos.x, y: pos.y };
      const node = findNode(pos.x, pos.y);

      if (node) {
        touchDragNode = node;
        const [wx, wy] = toWorld(pos.x, pos.y);
        node.fx = wx;
        node.fy = wy;
        simulation.alphaTarget(0.3).restart();
      } else {
        touchPanStart = { x: pos.x, y: pos.y, tx: transform.x, ty: transform.y };
      }
    }
  }, { passive: false });

  canvas.addEventListener("touchmove", (e) => {
    e.preventDefault();

    if (e.touches.length === 2 && pinchStart) {
      const newDist = pinchDist(e);
      const ratio = newDist / pinchStart.dist;
      const newK = Math.max(0.2, Math.min(5, pinchStart.k * ratio));
      const scaleRatio = newK / transform.k;

      transform.x = pinchStart.mx - scaleRatio * (pinchStart.mx - transform.x);
      transform.y = pinchStart.my - scaleRatio * (pinchStart.my - transform.y);
      transform.k = newK;
      draw();
      return;
    }

    if (e.touches.length === 1) {
      const pos = getTouchPos(e);

      if (touchDragNode) {
        const [wx, wy] = toWorld(pos.x, pos.y);
        touchDragNode.fx = wx;
        touchDragNode.fy = wy;
        simulation.alpha(0.3).restart();
        touchStartPos = null; // moved — not a tap
      } else if (touchPanStart) {
        transform.x = touchPanStart.tx + (pos.x - touchPanStart.x);
        transform.y = touchPanStart.ty + (pos.y - touchPanStart.y);
        draw();
        touchStartPos = null; // moved — not a tap
      }
    }
  }, { passive: false });

  canvas.addEventListener("touchend", (e) => {
    e.preventDefault();

    // Handle tap (no significant movement)
    if (touchStartPos && e.changedTouches.length === 1) {
      const rect = canvas.getBoundingClientRect();
      const endX = e.changedTouches[0].clientX - rect.left;
      const endY = e.changedTouches[0].clientY - rect.top;
      const dx = endX - touchStartPos.x;
      const dy = endY - touchStartPos.y;

      if (dx * dx + dy * dy < 100) { // < 10px movement
        const node = findNode(endX, endY);
        if (node) {
          hoveredNode = node;
          connectedIds = getConnected(node);
          showTooltip(node, endX, endY);
          draw();
        } else {
          hideTooltip();
        }
      }
    }

    if (touchDragNode) {
      touchDragNode.fx = null;
      touchDragNode.fy = null;
      simulation.alphaTarget(0);
      touchDragNode = null;
    }

    touchPanStart = null;
    touchStartPos = null;

    if (e.touches.length < 2) {
      pinchStart = null;
    }
  }, { passive: false });

  // --- Resize ---
  window.addEventListener("resize", () => {
    resizeCanvas();
    simulation.force("center", forceCenter(width / 2, height / 2));
    simulation.alpha(0.3).restart();
  });

  // Set initial cursor
  canvas.style.cursor = "grab";
</script>
