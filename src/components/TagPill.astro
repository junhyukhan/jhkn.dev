---
const { tag, size = "sm" } = Astro.props;

const config = {
    sm: "px-2 py-1 text-sm",
    base: "px-3 py-2 text-base",
};

const classes = config[size as keyof typeof config] || config.sm;
---

<a
    href={`/tags/${tag}`}
    class={`inline-block font-mono text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 rounded hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors no-underline ${classes}`}
>
    #{tag}
</a>
