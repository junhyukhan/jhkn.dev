---
import NoteList from "../../components/NoteList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Notes";
const allNotes = await getCollection("notes");

const groupedNotes = allNotes.reduce(
	(acc, note) => {
		const parts = note.slug.split("/");
		const category = parts.length > 1 ? parts[0] : "General";
		if (!acc[category]) acc[category] = [];
		acc[category].push(note);
		return acc;
	},
	{} as Record<string, typeof allNotes>,
);

Object.keys(groupedNotes).forEach((category) => {
	groupedNotes[category].sort(
		(a, b) =>
			new Date(b.data.created).valueOf() -
			new Date(a.data.created).valueOf(),
	);
});

const categories = Object.keys(groupedNotes).sort();
---

<BaseLayout pageTitle={pageTitle}>
	<section class="mb-12">
		<h1 class="text-3xl font-bold mb-4">Notes</h1>
		<p class="mb-8 text-gray-600">
			A collection of raw thoughts, snippets, and learnings. These are
			less polished than blog posts and more like a digital garden.
		</p>

		<div class="space-y-12">
			{
				Object.entries(groupedNotes).map(([category, notes]) => (
					<section>
						<h2 class="text-xl font-bold mb-4 capitalize text-gray-800 border-b border-gray-200 pb-2">
							{category}
						</h2>
						<NoteList notes={notes} />
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>
