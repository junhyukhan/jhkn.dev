---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Tags";
const allPosts = await getCollection("blog");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())].sort();
---

<BaseLayout pageTitle={pageTitle}>
    <h1 class="text-3xl font-bold mb-8">Tags</h1>
    <div class="flex flex-wrap gap-4">
        {
            tags.map((tag) => (
                <a
                    href={`/tags/${tag}`}
                    class="inline-block text-base font-mono text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-3 py-2 rounded hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors no-underline"
                >
                    #{tag}
                </a>
            ))
        }
    </div>
</BaseLayout>
