---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNoteTitle } from "../../utils/note";
import { buildBacklinksMap } from "../../utils/backlinks";
import TagList from "../../components/TagList.astro";
import Backlinks from "../../components/Backlinks.astro";

export async function getStaticPaths() {
    const notesEntries = await getCollection("notes");
    const backlinksMap = buildBacklinksMap(notesEntries);

    return notesEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry, backlinks: backlinksMap.get(entry.id) || [] },
    }));
}

const { entry, backlinks } = Astro.props;
const { Content } = await render(entry);
const title = getNoteTitle(entry);
---

<BaseLayout pageTitle={title}>
    <article class="prose prose-slate max-w-none">
        <header class="mb-10">
            <h1 class="text-2xl font-bold mb-2 tracking-tight">{title}</h1>
            <time class="text-sm text-gray-400 font-mono tabular-nums">
                {entry.data.created.toISOString().slice(0, 10)}
            </time>
        </header>
        <div class="font-mono text-sm leading-relaxed">
            <Content />
        </div>
        <footer class="mt-12 pt-8 border-t border-gray-100 space-y-6">
            <div>
                <span
                    class="font-mono text-xs text-gray-400 uppercase tracking-widest"
                    >Tags</span
                >
                <div class="mt-2">
                    <TagList tags={entry.data.tags} />
                </div>
            </div>
            <Backlinks backlinks={backlinks} />
        </footer>
    </article>
</BaseLayout>
