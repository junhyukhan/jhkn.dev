---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import NoteListItem from "../../components/NoteListItem.astro";

const pageTitle = "Notes";
const allNotes = await getCollection("notes");

const groupedNotes = allNotes.reduce(
	(acc, note) => {
		const parts = note.slug.split("/");
		const category = parts.length > 1 ? parts[0] : "General";
		if (!acc[category]) acc[category] = [];
		acc[category].push(note);
		return acc;
	},
	{} as Record<string, typeof allNotes>,
);

Object.keys(groupedNotes).forEach((category) => {
	groupedNotes[category].sort(
		(a, b) =>
			new Date(b.data.created).valueOf() -
			new Date(a.data.created).valueOf(),
	);
});

const categories = Object.keys(groupedNotes).sort();
---

<BaseLayout pageTitle={pageTitle}>
	<section>
		<h1 class="text-3xl font-bold mb-8">Notes</h1>
		<p class="mb-8 text-gray-600 dark:text-gray-400">
			A collection of loose thoughts, code snippets, and TILs.
		</p>

		<div class="space-y-10">
			{
				categories.map((category) => (
					<div>
						<h2 class="text-lg font-bold mb-4 capitalize text-gray-800 dark:text-gray-200">
							{category}
						</h2>
						<ul class="font-mono text-sm space-y-2">
							{groupedNotes[category].map((note) => (
								<NoteListItem note={note} />
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>
</BaseLayout>
