---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildGraphData } from "../utils/graph";

const allNotes = await getCollection("notes");
const graphData = buildGraphData(allNotes);
---

<BaseLayout pageTitle="Graph" wide={true}>
  <div class="relative">
    <div class="flex items-baseline justify-between mb-4">
      <h1 class="text-2xl font-bold tracking-tight">Graph</h1>
      <div id="graph-legend" class="flex gap-4 font-mono text-xs text-gray-400">
        <span class="flex items-center gap-1">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#3b82f6"></span>
          General
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#f59e0b"></span>
          LeetCode
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#22c55e"></span>
          Quotes
        </span>
      </div>
    </div>

    <div id="graph-tooltip"
      class="hidden absolute z-10 pointer-events-none bg-white border border-gray-200 rounded-lg shadow-lg px-3 py-2 text-sm max-w-xs">
    </div>

    <div id="graph-container" class="border border-gray-200 rounded-lg overflow-hidden bg-gray-50"
      style="height: 70vh;">
      <canvas id="graph-canvas"></canvas>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />

<script>
  import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide } from "d3-force";

  const graphData = JSON.parse(document.getElementById("graph-data")!.textContent!);

  const GROUP_COLORS: Record<string, string> = {
    general: "#3b82f6",
    leetcode: "#f59e0b",
    quotes: "#22c55e",
  };
  const DEFAULT_COLOR = "#94a3b8";

  // --- Canvas setup ---
  const container = document.getElementById("graph-container")!;
  const canvas = document.getElementById("graph-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const tooltip = document.getElementById("graph-tooltip")!;

  const dpr = window.devicePixelRatio || 1;
  let width = container.clientWidth;
  let height = container.clientHeight;

  function resizeCanvas() {
    width = container.clientWidth;
    height = container.clientHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = width + "px";
    canvas.style.height = height + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resizeCanvas();

  // --- Transform state (zoom/pan) ---
  let transform = { x: 0, y: 0, k: 1 };

  function toScreen(px: number, py: number): [number, number] {
    return [px * transform.k + transform.x, py * transform.k + transform.y];
  }
  function toWorld(sx: number, sy: number): [number, number] {
    return [(sx - transform.x) / transform.k, (sy - transform.y) / transform.k];
  }

  // --- Graph data ---
  interface SimNode {
    id: string;
    slug: string;
    title: string;
    group: string;
    tags: string[];
    linkCount: number;
    x?: number;
    y?: number;
    vx?: number;
    vy?: number;
    fx?: number | null;
    fy?: number | null;
    index?: number;
  }
  interface SimLink {
    source: SimNode | string;
    target: SimNode | string;
  }

  const nodes: SimNode[] = graphData.nodes.map((n: any) => ({ ...n }));
  const links: SimLink[] = graphData.links.map((l: any) => ({ ...l }));

  function nodeRadius(d: SimNode): number {
    return Math.min(4 + d.linkCount * 1.5, 16);
  }

  // --- Simulation ---
  const simulation = forceSimulation(nodes as any)
    .force("link", forceLink(links as any).id((d: any) => d.id).distance(80).strength(0.3))
    .force("charge", forceManyBody().strength(-180))
    .force("center", forceCenter(width / 2, height / 2))
    .force("collide", forceCollide().radius((d: any) => nodeRadius(d) + 3))
    .on("tick", draw);

  // --- Hover state ---
  let hoveredNode: SimNode | null = null;
  let connectedIds: Set<string> | null = null;

  function getConnected(node: SimNode): Set<string> {
    const ids = new Set<string>([node.id]);
    for (const link of links) {
      const s = (link.source as SimNode).id;
      const t = (link.target as SimNode).id;
      if (s === node.id) ids.add(t);
      if (t === node.id) ids.add(s);
    }
    return ids;
  }

  // --- Drawing ---
  function draw() {
    ctx.save();
    ctx.clearRect(0, 0, width, height);
    ctx.translate(transform.x, transform.y);
    ctx.scale(transform.k, transform.k);

    const dimmed = hoveredNode !== null;

    // Draw links
    for (const link of links) {
      const s = link.source as SimNode;
      const t = link.target as SimNode;
      const isHighlighted = dimmed && connectedIds!.has(s.id) && connectedIds!.has(t.id);

      ctx.beginPath();
      ctx.moveTo(s.x!, s.y!);
      ctx.lineTo(t.x!, t.y!);
      if (dimmed && !isHighlighted) {
        ctx.strokeStyle = "rgba(0,0,0,0.04)";
        ctx.lineWidth = 0.5;
      } else if (isHighlighted) {
        ctx.strokeStyle = GROUP_COLORS[hoveredNode!.group] || DEFAULT_COLOR;
        ctx.lineWidth = 1.5;
      } else {
        ctx.strokeStyle = "rgba(0,0,0,0.1)";
        ctx.lineWidth = 0.8;
      }
      ctx.stroke();
    }

    // Draw nodes
    for (const node of nodes) {
      const r = nodeRadius(node);
      const color = GROUP_COLORS[node.group] || DEFAULT_COLOR;
      const isHovered = hoveredNode === node;
      const isConnected = dimmed && connectedIds!.has(node.id);

      ctx.beginPath();
      ctx.arc(node.x!, node.y!, isHovered ? r * 1.3 : r, 0, Math.PI * 2);

      if (dimmed && !isConnected) {
        ctx.fillStyle = color + "20";
      } else {
        ctx.fillStyle = color;
      }
      ctx.fill();

      if (isHovered) {
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // Draw labels for hubs or hovered/connected nodes
      const showLabel = node.linkCount >= 5 || isHovered || (dimmed && isConnected);
      if (showLabel) {
        const fontSize = Math.max(10, Math.min(12, 9 + node.linkCount * 0.3));
        ctx.font = `${fontSize}px system-ui, -apple-system, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        ctx.fillStyle = dimmed && !isConnected ? "rgba(0,0,0,0.1)" : "rgba(0,0,0,0.7)";
        ctx.fillText(node.title, node.x!, node.y! + r + 4);
      }
    }

    ctx.restore();
  }

  // --- Find node under cursor ---
  function findNode(mx: number, my: number): SimNode | null {
    const [wx, wy] = toWorld(mx, my);
    for (let i = nodes.length - 1; i >= 0; i--) {
      const node = nodes[i];
      const r = nodeRadius(node) + 2;
      const dx = wx - node.x!;
      const dy = wy - node.y!;
      if (dx * dx + dy * dy < r * r) return node;
    }
    return null;
  }

  // --- Mouse interaction ---
  let isDragging = false;
  let dragNode: SimNode | null = null;
  let panStart: { x: number; y: number; tx: number; ty: number } | null = null;

  canvas.addEventListener("mousemove", (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    if (dragNode) {
      const [wx, wy] = toWorld(mx, my);
      dragNode.fx = wx;
      dragNode.fy = wy;
      simulation.alpha(0.3).restart();
      return;
    }

    if (panStart) {
      transform.x = panStart.tx + (mx - panStart.x);
      transform.y = panStart.ty + (my - panStart.y);
      draw();
      return;
    }

    const node = findNode(mx, my);
    if (node !== hoveredNode) {
      hoveredNode = node;
      connectedIds = node ? getConnected(node) : null;
      canvas.style.cursor = node ? "pointer" : "grab";

      if (node) {
        const tags = node.tags.length ? node.tags.join(", ") : "none";
        tooltip.innerHTML = `
          <div class="font-medium">${node.title}</div>
          <div class="text-gray-400 text-xs font-mono mt-1">${node.linkCount} connections · ${node.group}</div>
          <div class="text-gray-400 text-xs font-mono">tags: ${tags}</div>
        `;
        tooltip.classList.remove("hidden");
        tooltip.style.left = (mx + 12) + "px";
        tooltip.style.top = (my - 10) + "px";
      } else {
        tooltip.classList.add("hidden");
      }
      draw();
    } else if (node) {
      tooltip.style.left = (mx + 12) + "px";
      tooltip.style.top = (my - 10) + "px";
    }
  });

  canvas.addEventListener("mousedown", (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    const node = findNode(mx, my);

    if (node) {
      isDragging = true;
      dragNode = node;
      const [wx, wy] = toWorld(mx, my);
      node.fx = wx;
      node.fy = wy;
      simulation.alphaTarget(0.3).restart();
    } else {
      panStart = { x: mx, y: my, tx: transform.x, ty: transform.y };
      canvas.style.cursor = "grabbing";
    }
  });

  canvas.addEventListener("mouseup", () => {
    if (dragNode) {
      dragNode.fx = null;
      dragNode.fy = null;
      simulation.alphaTarget(0);
    }
    dragNode = null;
    isDragging = false;
    panStart = null;
    canvas.style.cursor = hoveredNode ? "pointer" : "grab";
  });

  canvas.addEventListener("click", (e) => {
    if (isDragging) return;
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    const node = findNode(mx, my);
    if (node) {
      window.location.href = `/notes/${node.slug}/`;
    }
  });

  // --- Zoom ---
  canvas.addEventListener("wheel", (e) => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    const factor = e.deltaY < 0 ? 1.1 : 0.9;
    const newK = Math.max(0.2, Math.min(5, transform.k * factor));
    const ratio = newK / transform.k;

    transform.x = mx - ratio * (mx - transform.x);
    transform.y = my - ratio * (my - transform.y);
    transform.k = newK;

    draw();
  }, { passive: false });

  // --- Resize ---
  window.addEventListener("resize", () => {
    resizeCanvas();
    simulation.force("center", forceCenter(width / 2, height / 2));
    simulation.alpha(0.3).restart();
  });

  // Set initial cursor
  canvas.style.cursor = "grab";
</script>
