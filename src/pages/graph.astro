---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildGraphData } from "../utils/graph";

const allNotes = await getCollection("notes");
const graphData = buildGraphData(allNotes);

const GROUP_COLORS: Record<string, string> = {
  general: "#3b82f6",
  leetcode: "#f59e0b",
  quotes: "#22c55e",
};
const DEFAULT_COLOR = "#94a3b8";

const groups = [...new Set(graphData.nodes.map((n) => n.group))].sort();
---

<BaseLayout pageTitle="Graph" wide={true}>
  <div class="relative">
    <div class="flex items-baseline justify-between mb-4">
      <h1 class="text-2xl font-bold tracking-tight">Graph</h1>
      <div id="graph-legend" class="flex gap-4 font-mono text-xs text-gray-400">
        {groups.map((group) => (
          <span class="flex items-center gap-1">
            <span class="inline-block w-2.5 h-2.5 rounded-full" style={`background:${GROUP_COLORS[group] || DEFAULT_COLOR}`}></span>
            {group.charAt(0).toUpperCase() + group.slice(1)}
          </span>
        ))}
      </div>
    </div>

    <div id="graph-tooltip"
      class="hidden absolute z-10 bg-white border border-gray-200 rounded-lg shadow-lg px-3 py-2 text-sm"
      style="width: 200px;">
    </div>

    <div id="graph-container" class="border border-gray-200 rounded-lg overflow-hidden bg-gray-50"
      style="height: 70vh;">
      <canvas id="graph-canvas" style="touch-action: none;"></canvas>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />

<script>
  import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide, forceX, forceY } from "d3-force";

  const graphData = JSON.parse(document.getElementById("graph-data")!.textContent!);

  const GROUP_COLORS: Record<string, string> = {
    general: "#3b82f6",
    leetcode: "#f59e0b",
    quotes: "#22c55e",
  };
  const DEFAULT_COLOR = "#94a3b8";

  function escapeHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  // --- Canvas setup ---
  const container = document.getElementById("graph-container")!;
  const canvas = document.getElementById("graph-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const tooltip = document.getElementById("graph-tooltip")!;

  const dpr = window.devicePixelRatio || 1;
  let width = container.clientWidth;
  let height = container.clientHeight;

  function resizeCanvas() {
    width = container.clientWidth;
    height = container.clientHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = width + "px";
    canvas.style.height = height + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resizeCanvas();

  // --- Transform state (zoom + pan) ---
  let transform = { x: 0, y: 0, k: 1 };

  function toWorld(sx: number, sy: number): [number, number] {
    return [(sx - transform.x) / transform.k, (sy - transform.y) / transform.k];
  }

  // --- Graph data ---
  interface SimNode {
    id: string;
    slug: string;
    title: string;
    group: string;
    tags: string[];
    linkCount: number;
    x?: number;
    y?: number;
    vx?: number;
    vy?: number;
    fx?: number | null;
    fy?: number | null;
    index?: number;
  }
  interface SimLink {
    source: SimNode | string;
    target: SimNode | string;
  }

  const nodes: SimNode[] = graphData.nodes.map((n: any) => ({ ...n }));
  const links: SimLink[] = graphData.links.map((l: any) => ({ ...l }));

  function nodeRadius(d: SimNode): number {
    return Math.min(10 + d.linkCount * 2.5, 28);
  }

  // Non-linear zoom compensation: partially counter-scales visual sizes
  // so elements stay readable when zoomed out but still shrink noticeably.
  function compensate(): number {
    return 1 / Math.pow(transform.k, 0.4);
  }

  // --- Simulation ---
  const simulation = forceSimulation(nodes as any)
    .force("link", forceLink(links as any).id((d: any) => d.id).distance(100).strength(0.3))
    .force("charge", forceManyBody().strength(-250))
    .force("center", forceCenter(width / 2, height / 2))
    .force("gravityX", forceX(width / 2).strength(0.03))
    .force("gravityY", forceY(height / 2).strength(0.03))
    .force("collide", forceCollide().radius((d: any) => nodeRadius(d) + 3))
    .on("tick", draw);

  // --- Hover state ---
  let hoveredNode: SimNode | null = null;
  let connectedIds: Set<string> | null = null;

  function getConnected(node: SimNode): Set<string> {
    const ids = new Set<string>([node.id]);
    for (const link of links) {
      const s = (link.source as SimNode).id;
      const t = (link.target as SimNode).id;
      if (s === node.id) ids.add(t);
      if (t === node.id) ids.add(s);
    }
    return ids;
  }

  // --- Drawing ---
  function draw() {
    ctx.save();
    ctx.clearRect(0, 0, width, height);
    ctx.translate(transform.x, transform.y);
    ctx.scale(transform.k, transform.k);

    const dimmed = hoveredNode !== null;
    const c = compensate();

    // Draw links
    for (const link of links) {
      const s = link.source as SimNode;
      const t = link.target as SimNode;
      const isHighlighted = dimmed && connectedIds!.has(s.id) && connectedIds!.has(t.id);

      ctx.beginPath();
      ctx.moveTo(s.x!, s.y!);
      ctx.lineTo(t.x!, t.y!);
      if (dimmed && !isHighlighted) {
        ctx.strokeStyle = "rgba(0,0,0,0.04)";
        ctx.lineWidth = 1 * c;
      } else if (isHighlighted) {
        ctx.strokeStyle = GROUP_COLORS[hoveredNode!.group] || DEFAULT_COLOR;
        ctx.lineWidth = 2.5 * c;
      } else {
        ctx.strokeStyle = "rgba(0,0,0,0.15)";
        ctx.lineWidth = 1.5 * c;
      }
      ctx.stroke();
    }

    // Draw nodes
    for (const node of nodes) {
      const r = nodeRadius(node) * c;
      const color = GROUP_COLORS[node.group] || DEFAULT_COLOR;
      const isHovered = hoveredNode === node;
      const isConnected = dimmed && connectedIds!.has(node.id);
      const drawR = isHovered ? r * 1.2 : r;

      ctx.beginPath();
      ctx.arc(node.x!, node.y!, drawR, 0, Math.PI * 2);

      if (dimmed && !isConnected) {
        ctx.fillStyle = color + "18";
      } else {
        ctx.fillStyle = color;
        ctx.globalAlpha = isHovered ? 1 : 0.85;
      }
      ctx.fill();
      ctx.globalAlpha = 1;

      if (isHovered) {
        ctx.strokeStyle = "white";
        ctx.lineWidth = 2 * c;
        ctx.stroke();
      }

      // Show more labels when zoomed in
      const hubThreshold = transform.k > 1.5 ? 2 : 5;
      const showLabel = node.linkCount >= hubThreshold || isHovered || (dimmed && isConnected);
      if (showLabel) {
        const fontSize = Math.max(10, Math.min(12, 9 + node.linkCount * 0.3)) * c;
        ctx.font = `${fontSize}px system-ui, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        ctx.fillStyle = dimmed && !isConnected ? "rgba(0,0,0,0.1)" : "rgba(0,0,0,0.7)";
        ctx.fillText(node.title, node.x!, node.y! + r + 4 * c);
      }
    }

    ctx.restore();

    // Keep tooltip anchored to the hovered node's screen position
    if (hoveredNode && !tooltip.classList.contains("hidden")) {
      const sx = hoveredNode.x! * transform.k + transform.x;
      const sy = hoveredNode.y! * transform.k + transform.y;
      positionTooltip(sx, sy);
    }
  }

  // --- Find node under cursor ---
  function findNode(mx: number, my: number): SimNode | null {
    const [wx, wy] = toWorld(mx, my);
    const c = compensate();
    const minHitR = 20 / transform.k;

    let closest: SimNode | null = null;
    let closestDist = Infinity;

    for (const node of nodes) {
      const visualR = nodeRadius(node) * c;
      const hitR = Math.max(visualR, minHitR);
      const dx = wx - node.x!;
      const dy = wy - node.y!;
      const dist = dx * dx + dy * dy;
      if (dist < hitR * hitR && dist < closestDist) {
        closest = node;
        closestDist = dist;
      }
    }
    return closest;
  }

  // --- Tooltip ---
  const TOOLTIP_W = 200;
  const TOOLTIP_GAP = 12;

  function positionTooltip(sx: number, sy: number) {
    const cw = container.clientWidth;
    const ch = container.clientHeight;
    const th = tooltip.offsetHeight || 80;

    let left = sx + TOOLTIP_GAP;
    if (left + TOOLTIP_W > cw) {
      left = sx - TOOLTIP_GAP - TOOLTIP_W;
    }
    left = Math.max(4, Math.min(left, cw - TOOLTIP_W - 4));

    let top = sy - 10;
    top = Math.max(4, Math.min(top, ch - th - 4));

    tooltip.style.left = left + "px";
    tooltip.style.top = top + "px";
  }

  function showTooltip(node: SimNode, screenX: number, screenY: number) {
    const tags = node.tags.length ? node.tags.map(escapeHtml).join(", ") : "none";
    tooltip.innerHTML = `
      <a href="/notes/${encodeURI(node.slug)}/" class="font-medium text-gray-900 hover:underline">${escapeHtml(node.title)}</a>
      <div class="text-gray-400 text-xs font-mono mt-1">${node.linkCount} connections · ${escapeHtml(node.group)}</div>
      <div class="text-gray-400 text-xs font-mono">tags: ${tags}</div>
    `;
    tooltip.classList.remove("hidden");
    positionTooltip(screenX, screenY);
  }

  function hideTooltip() {
    tooltip.classList.add("hidden");
    hoveredNode = null;
    connectedIds = null;
    draw();
  }

  // --- Unified pointer interaction ---
  const activePointers = new Map<number, { x: number; y: number }>();
  let dragNode: SimNode | null = null;
  let pendingNode: SimNode | null = null; // node under pointer, not yet dragging
  let panStart: { x: number; y: number; tx: number; ty: number } | null = null;
  let pinchStartDist: number | null = null;
  let pinchStartK: number | null = null;
  let tapStart: { x: number; y: number } | null = null;
  const DRAG_THRESHOLD = 25; // squared px before drag activates

  function getPointerPos(e: PointerEvent): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  }

  function getPointerDist(): number {
    const pts = [...activePointers.values()];
    const dx = pts[0].x - pts[1].x;
    const dy = pts[0].y - pts[1].y;
    return Math.sqrt(dx * dx + dy * dy);
  }

  function getPointerMid(): { x: number; y: number } {
    const pts = [...activePointers.values()];
    return { x: (pts[0].x + pts[1].x) / 2, y: (pts[0].y + pts[1].y) / 2 };
  }

  canvas.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    canvas.setPointerCapture(e.pointerId);
    const pos = getPointerPos(e);
    activePointers.set(e.pointerId, pos);

    if (activePointers.size === 2) {
      // Start pinch — cancel any single-pointer action
      dragNode = null;
      pendingNode = null;
      panStart = null;
      tapStart = null;
      pinchStartDist = getPointerDist();
      pinchStartK = transform.k;
      return;
    }

    if (activePointers.size === 1) {
      tapStart = { x: pos.x, y: pos.y };
      const node = findNode(pos.x, pos.y);

      if (node) {
        // Don't start dragging yet — wait for movement past threshold
        pendingNode = node;
      } else {
        pendingNode = null;
        panStart = { x: pos.x, y: pos.y, tx: transform.x, ty: transform.y };
        canvas.style.cursor = "grabbing";
      }
    }
  });

  canvas.addEventListener("pointermove", (e) => {
    e.preventDefault();
    const pos = getPointerPos(e);
    activePointers.set(e.pointerId, pos);

    // Pinch zoom with 2 pointers
    if (activePointers.size === 2 && pinchStartDist !== null && pinchStartK !== null) {
      const newDist = getPointerDist();
      const mid = getPointerMid();
      const ratio = newDist / pinchStartDist;
      const newK = Math.max(0.05, Math.min(5, pinchStartK * ratio));
      const scaleRatio = newK / transform.k;

      transform.x = mid.x - scaleRatio * (mid.x - transform.x);
      transform.y = mid.y - scaleRatio * (mid.y - transform.y);
      transform.k = newK;
      draw();
      return;
    }

    // Single pointer
    if (activePointers.size === 1) {
      // Promote pending node to drag after movement threshold
      if (pendingNode && tapStart) {
        const dx = pos.x - tapStart.x;
        const dy = pos.y - tapStart.y;
        if (dx * dx + dy * dy > DRAG_THRESHOLD) {
          dragNode = pendingNode;
          const [wx, wy] = toWorld(pos.x, pos.y);
          dragNode.fx = wx;
          dragNode.fy = wy;
          simulation.alphaTarget(0.1).restart();
          pendingNode = null;
          tapStart = null;
        }
        return;
      }

      if (dragNode) {
        const [wx, wy] = toWorld(pos.x, pos.y);
        dragNode.fx = wx;
        dragNode.fy = wy;
        simulation.alpha(0.1).restart();
        return;
      }

      if (panStart) {
        transform.x = panStart.tx + (pos.x - panStart.x);
        transform.y = panStart.ty + (pos.y - panStart.y);
        draw();
        tapStart = null;
        return;
      }

      // Hover (mouse only — no active drag/pan means pointer is just moving)
      const node = findNode(pos.x, pos.y);
      if (node !== hoveredNode) {
        hoveredNode = node;
        connectedIds = node ? getConnected(node) : null;
        canvas.style.cursor = node ? "pointer" : "grab";

        if (node) {
          showTooltip(node, pos.x, pos.y);
        } else {
          if (!tooltip.matches(":hover")) {
            tooltip.classList.add("hidden");
          }
        }
        draw();
      } else if (node) {
        positionTooltip(pos.x, pos.y);
      }
    }
  });

  canvas.addEventListener("pointerup", (e) => {
    e.preventDefault();
    const pos = getPointerPos(e);

    // Handle tap (no significant movement)
    if (tapStart && activePointers.size === 1) {
      const dx = pos.x - tapStart.x;
      const dy = pos.y - tapStart.y;
      if (dx * dx + dy * dy < 100) {
        const node = findNode(pos.x, pos.y);
        if (node) {
          hoveredNode = node;
          connectedIds = getConnected(node);
          showTooltip(node, pos.x, pos.y);
          draw();
        } else {
          hideTooltip();
        }
      }
    }

    if (dragNode) {
      dragNode.fx = null;
      dragNode.fy = null;
      simulation.alphaTarget(0);
      dragNode = null;
    }

    pendingNode = null;
    panStart = null;
    tapStart = null;
    activePointers.delete(e.pointerId);

    if (activePointers.size < 2) {
      pinchStartDist = null;
      pinchStartK = null;
    }

    if (activePointers.size === 0) {
      canvas.style.cursor = hoveredNode ? "pointer" : "grab";
    }
  });

  canvas.addEventListener("pointercancel", (e) => {
    activePointers.delete(e.pointerId);
    if (dragNode) {
      dragNode.fx = null;
      dragNode.fy = null;
      simulation.alphaTarget(0);
      dragNode = null;
    }
    pendingNode = null;
    panStart = null;
    tapStart = null;
    if (activePointers.size < 2) {
      pinchStartDist = null;
      pinchStartK = null;
    }
  });

  // --- Zoom (wheel) ---
  canvas.addEventListener("wheel", (e) => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    const factor = e.deltaY < 0 ? 1.1 : 0.9;
    const newK = Math.max(0.05, Math.min(5, transform.k * factor));
    const ratio = newK / transform.k;

    transform.x = mx - ratio * (mx - transform.x);
    transform.y = my - ratio * (my - transform.y);
    transform.k = newK;

    draw();
  }, { passive: false });

  // --- Hide tooltip when pointer/mouse leaves ---
  canvas.addEventListener("pointerleave", () => {
    if (!tooltip.matches(":hover")) hideTooltip();
  });

  tooltip.addEventListener("mouseleave", () => {
    canvas.style.cursor = "grab";
    hideTooltip();
  });

  // --- Resize ---
  window.addEventListener("resize", () => {
    resizeCanvas();
    simulation.force("center", forceCenter(width / 2, height / 2));
    simulation.force("gravityX", forceX(width / 2).strength(0.03));
    simulation.force("gravityY", forceY(height / 2).strength(0.03));
    simulation.alpha(0.3).restart();
  });

  // Set initial cursor
  canvas.style.cursor = "grab";
</script>
