---
import "../styles/global.css";
const { pageTitle } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body
		class="font-sans text-gray-900 dark:text-gray-100 bg-white dark:bg-gray-950"
	>
		<main class="max-w-2xl mx-auto px-4 py-8">
			<nav class="flex justify-between mb-12 items-baseline">
				<a href="/" class="font-bold text-xl">JHKN.DEV</a>
				<div class="space-x-4 text-sm font-medium text-gray-500">
					<a
						href="/blog"
						class="hover:text-black dark:hover:text-white transition-colors"
						>Blog</a
					>
					<a
						href="/notes"
						class="hover:text-black dark:hover:text-white transition-colors"
						>Notes</a
					>
				</div>
			</nav>

			<slot />

			<footer class="mt-20 text-sm text-gray-400 font-mono">
				&copy; {new Date().getFullYear()} JHKN.DEV
			</footer>
		</main>
	</body>
</html>
