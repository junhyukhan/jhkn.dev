---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import NoteListItem from "../../components/NoteListItem.astro";

const pageTitle = "Notes";
const allNotes = await getCollection("notes");
// Sort by title or date? Notes are often evergreen, but date is fine.
const sortedNotes = allNotes.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout pageTitle={pageTitle}>
	<section>
		<h1 class="text-3xl font-bold mb-8">Notes</h1>
		<p class="mb-8 text-gray-600 dark:text-gray-400">
			A collection of loose thoughts, code snippets, and TILs.
		</p>

		<ul class="font-mono text-sm space-y-2">
			{sortedNotes.map((note) => <NoteListItem note={note} />)}
		</ul>
	</section>
</BaseLayout>
