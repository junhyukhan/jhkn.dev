---
import type { CollectionEntry } from "astro:content";
import { getNoteTitle } from "../utils/note";

interface Props {
  backlinks: CollectionEntry<"notes">[];
}

const { backlinks } = Astro.props;
---

{
  backlinks.length > 0 && (
    <div>
      <span class="font-mono text-xs text-gray-400 uppercase tracking-widest">
        Linked from
      </span>
      <ul class="mt-2 space-y-1 font-mono text-sm">
        {backlinks.map((note) => (
          <li>
            <a
              href={`/${note.collection}/${note.slug}/`}
              class="text-blue-600 hover:underline transition-colors duration-150"
            >
              {getNoteTitle(note)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
