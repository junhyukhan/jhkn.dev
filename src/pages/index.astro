---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import NoteList from "../components/NoteList.astro";

const pageTitle = "JHKN.DEV";
const allNotes = await getCollection("notes");
const recentNotes = allNotes
    .sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf())
    .slice(0, 3);
---

<BaseLayout pageTitle={pageTitle}>
    <section class="mb-12">
        <h1 class="text-3xl font-bold mb-4">Hello.</h1>
        <p class="text-gray-600">
            This is where I document what I learn and build.
        </p>
    </section>

    <section>
        <div class="flex justify-between items-baseline mb-8">
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-500">
                Recent Notes
            </h2>
            <a
                href="/notes"
                class="text-sm text-gray-500 hover:text-black transition-colors"
            >
                View all &rarr;
            </a>
        </div>

        <NoteList notes={recentNotes} />
    </section>
</BaseLayout>
