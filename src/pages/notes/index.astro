---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getNoteTitle } from "../../utils/note";
import { buildBacklinksWithContextMap } from "../../utils/backlinks";

const pageTitle = "Notes";
const allNotes = await getCollection("notes");

const backlinksMap = buildBacklinksWithContextMap(allNotes);
const backlinkCountById = new Map<string, number>(
	allNotes.map((note) => [note.id, backlinksMap.get(note.id)?.length ?? 0])
);

// Collect unique tags sorted by frequency
const tagCounts: Record<string, number> = {};
allNotes.forEach((note) => {
	(note.data.tags || []).forEach((tag) => {
		tagCounts[tag] = (tagCounts[tag] || 0) + 1;
	});
});
const sortedTags = Object.entries(tagCounts)
	.sort((a, b) => b[1] - a[1])
	.map(([tag, count]) => ({ tag, count }));

// Pre-sort by date desc (default view)
const sortedNotes = [...allNotes].sort(
	(a, b) =>
		new Date(b.data.created).valueOf() - new Date(a.data.created).valueOf()
);

const totalCount = sortedNotes.length;
---

<BaseLayout pageTitle={pageTitle}>
	<div class="relative mb-12">

		<!--
			Desktop sidebar (xl+): absolutely positioned in the left whitespace,
			does not displace the notes column at all. The inner div is sticky so
			it follows the viewport while scrolling through notes.
			At xl (1280px) the left whitespace is ~296px; sidebar + gap = ~240px — fits.
		-->
		<aside class="hidden xl:block absolute top-0 right-full h-full pr-8">
			<div class="sticky top-8 w-52 space-y-5">
				<input
					id="search"
					type="text"
					placeholder="Search by title..."
					autocomplete="off"
					class="w-full font-mono text-base sm:text-sm border border-gray-200 rounded px-3 py-2 focus:outline-none focus:border-gray-400 touch-manipulation"
				/>
				<div class="font-mono text-xs text-gray-500">
					<div class="text-gray-400 uppercase tracking-wider mb-1 text-[10px]">Sort</div>
					<div class="flex flex-wrap gap-x-3 gap-y-1">
						<button class="sort-btn touch-manipulation underline text-gray-700" data-sort="date" data-dir="desc" aria-pressed="true">Date ↓</button>
						<button class="sort-btn touch-manipulation" data-sort="date" data-dir="asc" aria-pressed="false">Date ↑</button>
						<button class="sort-btn touch-manipulation" data-sort="title" data-dir="asc" aria-pressed="false">A→Z</button>
						<button class="sort-btn touch-manipulation" data-sort="title" data-dir="desc" aria-pressed="false">Z→A</button>
						<button class="sort-btn touch-manipulation" data-sort="backlinks" data-dir="desc" aria-pressed="false">Most linked</button>
					</div>
				</div>
				<div class="font-mono text-xs">
					<div class="text-gray-400 uppercase tracking-wider mb-1 text-[10px]">Tags</div>
					<div class="flex flex-wrap gap-1 max-h-80 overflow-y-auto">
						<button class="tag-all-btn touch-manipulation text-left px-2 py-1 rounded bg-blue-100 text-blue-700 hover:bg-blue-200" aria-pressed="true">
							All
						</button>
						{sortedTags.map(({ tag, count }) => (
							<button
								class="tag-btn touch-manipulation text-left px-2 py-1 rounded bg-gray-100 text-gray-600 hover:bg-gray-200"
								data-tag={tag}
								aria-pressed="false"
							>
								{tag} <span class="text-gray-400">({count})</span>
							</button>
						))}
					</div>
				</div>
			</div>
		</aside>

		<!-- Notes: occupies the full max-w-2xl column, position unchanged from original -->
		<section>
			<h1 class="text-3xl font-bold mb-4">Notes</h1>
			<p class="mb-6 text-gray-600">
				A collection of raw thoughts, snippets, and learnings. These are
				less polished than blog posts and more like a digital garden.
			</p>

			<!-- Mobile + lg: collapsible below header, hidden once the xl sidebar takes over -->
			<details class="xl:hidden border border-gray-200 rounded px-3 py-2 mb-6">
				<summary class="font-mono text-xs text-gray-500 cursor-pointer select-none py-1 touch-manipulation">
					Filters &amp; search
				</summary>
				<div class="mt-3 pb-1 space-y-4">
					<input
						id="search-mobile"
						type="text"
						placeholder="Search by title..."
						autocomplete="off"
						class="w-full font-mono text-base sm:text-sm border border-gray-200 rounded px-3 py-2 focus:outline-none focus:border-gray-400 touch-manipulation"
					/>
					<div class="font-mono text-xs text-gray-500">
						<div class="text-gray-400 uppercase tracking-wider mb-1 text-[10px]">Sort</div>
						<div class="flex flex-wrap gap-x-3 gap-y-1">
							<button class="sort-btn touch-manipulation underline text-gray-700" data-sort="date" data-dir="desc" aria-pressed="true">Date ↓</button>
							<button class="sort-btn touch-manipulation" data-sort="date" data-dir="asc" aria-pressed="false">Date ↑</button>
							<button class="sort-btn touch-manipulation" data-sort="title" data-dir="asc" aria-pressed="false">A→Z</button>
							<button class="sort-btn touch-manipulation" data-sort="title" data-dir="desc" aria-pressed="false">Z→A</button>
							<button class="sort-btn touch-manipulation" data-sort="backlinks" data-dir="desc" aria-pressed="false">Most linked</button>
						</div>
					</div>
					<div class="font-mono text-xs">
						<div class="text-gray-400 uppercase tracking-wider mb-1 text-[10px]">Tags</div>
						<div class="flex flex-wrap gap-1 max-h-48 overflow-y-auto">
							<button class="tag-all-btn touch-manipulation text-left px-2 py-1 rounded bg-blue-100 text-blue-700 hover:bg-blue-200" aria-pressed="true">
								All
							</button>
							{sortedTags.map(({ tag, count }) => (
								<button
									class="tag-btn touch-manipulation text-left px-2 py-1 rounded bg-gray-100 text-gray-600 hover:bg-gray-200"
									data-tag={tag}
									aria-pressed="false"
								>
									{tag} <span class="text-gray-400">({count})</span>
								</button>
							))}
						</div>
					</div>
				</div>
			</details>

			<p id="note-count" class="font-mono text-xs text-gray-400 mb-3">
				{totalCount} notes
			</p>

			<!-- Notes list (all rendered at build time; JS shows/hides/sorts) -->
			<ul id="notes-list" class="font-mono text-sm space-y-1">
				{
					sortedNotes.map((note) => {
						const title = getNoteTitle(note);
						const date = note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : "";
						const count = backlinkCountById.get(note.id) ?? 0;
						return (
							<li
								data-tags={JSON.stringify(note.data.tags || [])}
								data-date={date}
								data-title={title}
								data-backlinks={count}
							>
								<a
									href={`/${note.collection}/${note.slug}/`}
									class="flex items-baseline group"
								>
									<span class="text-xs text-gray-400 mr-4 shrink-0">{date}</span>
									<span class="group-hover:underline text-blue-600">{title}</span>
									{count > 0 && (
										<span class="ml-2 shrink-0 font-mono text-[10px] text-gray-400 tabular-nums">↩ {count}</span>
									)}
								</a>
							</li>
						);
					})
				}
				<li id="no-results" class="hidden font-mono text-sm text-gray-400">
					No notes match your filters.
				</li>
			</ul>
		</section>

	</div>
</BaseLayout>

<script>
	// State — initialized from URL by restoreUIFromState() via pageshow
	let query = "";
	let sortKey = "date";
	let sortDir = "desc";
	let prevSortKey = "";
	let prevSortDir = "";
	const selectedTags = new Set<string>();

	const notesList = document.getElementById("notes-list") as HTMLUListElement;
	const noteCount = document.getElementById("note-count") as HTMLParagraphElement;
	const noResults = document.getElementById("no-results") as HTMLLIElement;

	// Cache all item data once — avoids repeated DOM reads and JSON.parse on every filter call
	const allItems = Array.from(notesList.querySelectorAll<HTMLLIElement>("li:not(#no-results)")).map((li) => ({
		el: li,
		tags: JSON.parse(li.dataset.tags || "[]") as string[],
		date: li.dataset.date ?? "",
		title: (li.dataset.title ?? "").toLowerCase(),
		backlinks: parseInt(li.dataset.backlinks ?? "0", 10),
	}));

	function syncURL() {
		const p = new URLSearchParams();
		if (query) p.set("q", query);
		if (sortKey !== "date" || sortDir !== "desc") p.set("sort", `${sortKey}-${sortDir}`);
		selectedTags.forEach((tag) => p.append("tags", tag));
		const qs = p.toString();
		history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
	}

	function applyFilters() {
		const q = query.toLowerCase();
		const sortChanged = sortKey !== prevSortKey || sortDir !== prevSortDir;

		let sorted: typeof allItems;
		if (sortChanged) {
			sorted = [...allItems].sort((a, b) => {
				if (sortKey === "date") {
					const diff = a.date.localeCompare(b.date);
					return sortDir === "desc" ? -diff : diff;
				} else if (sortKey === "backlinks") {
					const diff = b.backlinks - a.backlinks;
					return diff !== 0 ? diff : b.date.localeCompare(a.date);
				} else {
					const diff = a.title.localeCompare(b.title, undefined, { sensitivity: "base" });
					return sortDir === "asc" ? diff : -diff;
				}
			});
			sorted.forEach(({ el }) => notesList.appendChild(el));
			prevSortKey = sortKey;
			prevSortDir = sortDir;
		} else {
			sorted = allItems;
		}

		let visible = 0;
		sorted.forEach(({ el, tags, title }) => {
			const matchesTag = selectedTags.size === 0 || tags.some((t) => selectedTags.has(t));
			const matchesQuery = !q || title.includes(q);

			if (matchesTag && matchesQuery) {
				el.style.display = "";
				visible++;
			} else {
				el.style.display = "none";
			}
		});

		noResults.classList.toggle("hidden", visible > 0);
		noteCount.textContent = `${visible} note${visible !== 1 ? "s" : ""}`;
	}

	function restoreUIFromState() {
		const params = new URLSearchParams(location.search);
		const sortParam = (params.get("sort") ?? "date-desc").split("-");
		query = params.get("q") ?? "";
		sortKey = sortParam[0] ?? "date";
		sortDir = sortParam[1] ?? "desc";
		selectedTags.clear();
		params.getAll("tags").forEach((t) => selectedTags.add(t));
		prevSortKey = "";
		prevSortDir = "";

		(["search", "search-mobile"] as const).forEach((id) => {
			const el = document.getElementById(id) as HTMLInputElement | null;
			if (el) el.value = query;
		});
		document.querySelectorAll<HTMLButtonElement>(".sort-btn").forEach((b) => {
			const active = b.dataset.sort === sortKey && b.dataset.dir === sortDir;
			b.classList.toggle("underline", active);
			b.classList.toggle("text-gray-700", active);
			b.setAttribute("aria-pressed", String(active));
		});
		updateTagStyles();
		// Auto-open the mobile filter panel if there are active filters
		if (query || selectedTags.size > 0 || sortKey !== "date" || sortDir !== "desc") {
			const details = document.querySelector<HTMLDetailsElement>("details.xl\\:hidden");
			if (details) details.open = true;
		}
		applyFilters();
	}

	// pageshow fires on both fresh loads and bfcache restores.
	// When persisted=true (bfcache), the browser may restore the DOM *after*
	// pageshow fires — including clearing autocomplete="off" inputs. Deferring
	// with setTimeout ensures we run after bfcache restoration is complete.
	window.addEventListener("pageshow", (e) => {
		if (e.persisted) {
			setTimeout(restoreUIFromState, 0);
		} else {
			restoreUIFromState();
		}
	});

	// Search inputs — desktop (#search) and mobile (#search-mobile), kept in sync
	let debounceTimer: ReturnType<typeof setTimeout>;
	(["search", "search-mobile"] as const).forEach((id) => {
		const el = document.getElementById(id) as HTMLInputElement | null;
		if (!el) return;
		el.addEventListener("input", (e) => {
			clearTimeout(debounceTimer);
			const value = (e.target as HTMLInputElement).value;
			const otherId = id === "search" ? "search-mobile" : "search";
			const other = document.getElementById(otherId) as HTMLInputElement | null;
			if (other) other.value = value;
			query = value;
			syncURL();
			debounceTimer = setTimeout(() => {
				applyFilters();
			}, 150);
		});
	});

	// Sort buttons — present in both panels; sync highlight + aria-pressed across both
	document.querySelectorAll<HTMLButtonElement>(".sort-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			sortKey = btn.dataset.sort ?? "date";
			sortDir = btn.dataset.dir ?? "desc";
			document.querySelectorAll<HTMLButtonElement>(".sort-btn").forEach((b) => {
				b.classList.remove("underline", "text-gray-700");
				b.setAttribute("aria-pressed", "false");
			});
			document
				.querySelectorAll<HTMLButtonElement>(
					`.sort-btn[data-sort="${sortKey}"][data-dir="${sortDir}"]`
				)
				.forEach((b) => {
					b.classList.add("underline", "text-gray-700");
					b.setAttribute("aria-pressed", "true");
				});
			syncURL();
			requestAnimationFrame(() => applyFilters());
		});
	});

	// "All" tag buttons (one per panel)
	document.querySelectorAll<HTMLButtonElement>(".tag-all-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			selectedTags.clear();
			updateTagStyles();
			syncURL();
			requestAnimationFrame(() => applyFilters());
		});
	});

	// Individual tag buttons
	document.querySelectorAll<HTMLButtonElement>(".tag-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			const tag = btn.dataset.tag!;
			if (selectedTags.has(tag)) selectedTags.delete(tag);
			else selectedTags.add(tag);
			updateTagStyles();
			syncURL();
			requestAnimationFrame(() => applyFilters());
		});
	});

	function updateTagStyles() {
		const isAll = selectedTags.size === 0;
		document.querySelectorAll<HTMLButtonElement>(".tag-all-btn").forEach((btn) => {
			btn.setAttribute("aria-pressed", String(isAll));
			btn.classList.toggle("bg-blue-100", isAll);
			btn.classList.toggle("text-blue-700", isAll);
			btn.classList.toggle("bg-gray-100", !isAll);
			btn.classList.toggle("text-gray-600", !isAll);
		});
		document.querySelectorAll<HTMLButtonElement>(".tag-btn").forEach((btn) => {
			const active = selectedTags.has(btn.dataset.tag!);
			btn.setAttribute("aria-pressed", String(active));
			btn.classList.toggle("bg-blue-100", active);
			btn.classList.toggle("text-blue-700", active);
			btn.classList.toggle("bg-gray-100", !active);
			btn.classList.toggle("text-gray-600", !active);
		});
	}
</script>
