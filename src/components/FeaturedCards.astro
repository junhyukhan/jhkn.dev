---
import type { CollectionEntry } from "astro:content";
import { getNoteTitle } from "../utils/note";

interface Props {
    notes: CollectionEntry<"notes">[];
}

const { notes } = Astro.props;
---

<ul class="grid gap-3 sm:grid-cols-2">
    {notes.map((note) => (
        <li class="rounded-lg border border-gray-200 px-4 py-3 transition-colors duration-150 hover:border-gray-300 hover:bg-gray-50">
            <a
                href={`/${note.collection}/${note.slug}/`}
                class="block font-medium text-gray-800 hover:text-blue-600 hover:no-underline transition-colors duration-150"
            >
                {getNoteTitle(note)}
            </a>
            <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-xs text-gray-400">
                <span class="tabular-nums">
                    {new Date(note.data.created).toISOString().slice(0, 10)}
                </span>
                {note.data.tags.map((tag) => (
                    <a href={`/notes?tags=${tag}`} class="text-gray-400 hover:text-gray-700 hover:no-underline">
                        #{tag}
                    </a>
                ))}
            </p>
        </li>
    ))}
</ul>
