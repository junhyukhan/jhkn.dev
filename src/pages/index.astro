---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "JHKN.DEV";
const allPosts = await getCollection("blog");
const recentPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<BaseLayout pageTitle={pageTitle}>
    <section class="mb-16">
        <h1 class="text-3xl font-bold mb-4">
            Hello. I am a software engineer building AI platforms and tinkering
            with home labs.
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
            I write about what I learn. Mostly Go, TypeScript, and
            infrastructure.
        </p>
    </section>

    <section>
        <div class="flex justify-between items-baseline mb-8">
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-500">
                Recent Posts
            </h2>
            <a
                href="/blog"
                class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors"
            >
                View all &rarr;
            </a>
        </div>

        <ul class="space-y-6">
            {
                recentPosts.map((post) => (
                    <li>
                        <a href={`/blog/${post.slug}/`} class="group block">
                            <div class="flex justify-between items-baseline">
                                <h3 class="text-lg font-medium group-hover:text-blue-600 transition-colors">
                                    {post.data.title}
                                </h3>
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                    class="text-sm text-gray-400 font-mono shrink-0 ml-4"
                                >
                                    {post.data.pubDate
                                        .toISOString()
                                        .slice(0, 10)}
                                </time>
                            </div>
                            <p class="text-gray-600 dark:text-gray-400 mt-1 line-clamp-2">
                                {post.data.description}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
