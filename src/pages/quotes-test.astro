---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const quotes = (await getCollection("notes")).filter((note) =>
    note.data.tags?.includes("quote")
);

function parseQuote(body: string): { text: string; source: string | null } {
    const paragraphs = body
        .trim()
        .split(/\n\n+/)
        .map((p) => p.trim())
        .filter(Boolean);

    if (paragraphs.length === 0) return { text: "", source: null };

    const text = paragraphs[0].replace(/^["""'']|["""'']$/g, "").trim();

    if (paragraphs.length === 1) return { text, source: null };

    const raw = paragraphs[paragraphs.length - 1];
    const source = raw.replace(/\[\[([^\]]+)\]\]/g, "$1").trim();

    return { text, source };
}

const parsed = quotes.map((quote) => ({
    quote,
    ...parseQuote(quote.body ?? ""),
}));
---

<BaseLayout pageTitle="Quotes Preview" noindex={true}>
    <section class="mb-12">
        <h1 class="text-2xl font-bold mb-2">Quotes Preview</h1>
        <p class="text-sm text-gray-400 mb-10">
            {quotes.length} quotes &mdash; as rendered in the Quote of the Day card
        </p>

        <div class="space-y-6">
            {parsed.map(({ quote, text, source }) => (
                <div>
                    <div class="text-xs text-gray-400 font-mono mb-1">
                        {quote.slug}
                    </div>
                    {text ? (
                        <div class="relative rounded-lg border border-gray-100 bg-gray-50 px-7 py-6">
                            <div
                                class="pointer-events-none absolute -top-1 left-4 select-none font-serif text-7xl leading-none text-gray-200"
                                aria-hidden="true"
                            >
                                &ldquo;
                            </div>
                            <blockquote class="relative mt-3 text-[0.95rem] leading-relaxed text-gray-700 italic">
                                {text}
                            </blockquote>
                            {source && (
                                <p class="mt-4 text-sm text-gray-400">
                                    &mdash;&thinsp;{source}
                                </p>
                            )}
                            <a
                                href={`/${quote.collection}/${quote.slug}/`}
                                class="absolute bottom-3 right-4 text-xs text-gray-300 hover:text-gray-500 transition-colors"
                            >
                                ↗
                            </a>
                        </div>
                    ) : (
                        <div class="rounded-lg border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-400">
                            Empty — no text parsed from body
                        </div>
                    )}
                </div>
            ))}
        </div>
    </section>
</BaseLayout>
