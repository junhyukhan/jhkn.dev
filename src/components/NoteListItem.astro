---
const { note } = Astro.props;
---

<li>
    <a href={`/notes/${note.slug}/`} class="flex items-baseline group">
        <span class="text-gray-400 mr-4 shrink-0">
            {note.data.pubDate.toISOString().slice(0, 10)}
        </span>
        <span class="group-hover:underline text-blue-600 dark:text-blue-400">
            {note.data.title}
        </span>
    </a>
</li>
