---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import WritingListItem from "../../components/WritingListItem.astro";

const pageTitle = "Writing";
const allWriting = await getCollection("writing");
const sortedWriting = allWriting.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout pageTitle={pageTitle}>
	<section>
		<h1 class="text-3xl font-bold mb-8">Writing</h1>
		<ul class="space-y-6">
			{sortedWriting.map((post) => <WritingListItem post={post} />)}
		</ul>
	</section>
</BaseLayout>
