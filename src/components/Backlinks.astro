---
import type { CollectionEntry } from "astro:content";
import { getNoteTitle } from "../utils/note";

interface Props {
  backlinks: CollectionEntry<"notes">[];
}

const { backlinks } = Astro.props;
---

{
  backlinks.length > 0 && (
    <div class="mt-8 pt-8 border-t border-gray-200">
      <span class="font-mono text-sm text-gray-500 mr-2 uppercase tracking-wider">
        Linked from
      </span>
      <ul class="mt-3 space-y-1 font-mono text-sm">
        {backlinks.map((note) => (
          <li>
            <a
              href={`/${note.collection}/${note.slug}/`}
              class="text-blue-600 hover:underline"
            >
              {getNoteTitle(note)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
