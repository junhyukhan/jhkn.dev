---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getNoteTitle } from "../utils/note";

const pageTitle = "Notes Filter UI Test";
const allNotes = await getCollection("notes");

// Get all unique tags with counts (excluding broad/meta tags)
const IGNORED_TAGS = ["cs", "question", "books", "quote", "cheatsheet", "config", "blog", "event", "feature", "bugfix"];
const tagCounts: Record<string, number> = {};
allNotes.forEach(note => {
	(note.data.tags || []).forEach(tag => {
		if (!IGNORED_TAGS.includes(tag)) {
			tagCounts[tag] = (tagCounts[tag] || 0) + 1;
		}
	});
});
const sortedTags = Object.entries(tagCounts)
	.sort((a, b) => b[1] - a[1])
	.map(([tag, count]) => ({ tag, count }));

// Sort notes by date
const sortedNotes = allNotes.sort((a, b) =>
	new Date(b.data.created).valueOf() - new Date(a.data.created).valueOf()
);

// Serialize for client-side JS
const notesData = sortedNotes.map(note => ({
	slug: `/${note.collection}/${note.slug}/`,
	title: getNoteTitle(note),
	date: note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : "",
	tags: note.data.tags || []
}));
---

<BaseLayout pageTitle={pageTitle}>
	<section class="mb-12">
		<h1 class="text-3xl font-bold mb-4">Tag Filter UI Test</h1>
		<p class="mb-8 text-gray-600">
			Compare different tag filtering approaches. Click tags to filter notes.
		</p>

		<!-- Option A: Tag Bar -->
		<div class="mb-16" id="option-a">
			<h2 class="text-lg font-bold mb-4 text-gray-400 border-b pb-2">Option A: Tag Bar</h2>
			<div class="flex flex-wrap gap-2 mb-4" id="tagbar-a">
				<button
					class="tag-btn-a active px-3 py-1 text-sm font-mono rounded-full bg-blue-100 text-blue-700"
					data-tag="all"
				>
					All
				</button>
				{sortedTags.slice(0, 10).map(({ tag, count }) => (
					<button
						class="tag-btn-a px-3 py-1 text-sm font-mono rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200"
						data-tag={tag}
					>
						{tag} <span class="text-gray-400">({count})</span>
					</button>
				))}
			</div>
			<ul class="font-mono text-sm space-y-1" id="notes-a">
				{sortedNotes.slice(0, 15).map((note) => (
					<li data-tags={JSON.stringify(note.data.tags || [])}>
						<a href={`/${note.collection}/${note.slug}/`} class="flex items-baseline group">
							<span class="text-gray-400 mr-4 shrink-0">
								{note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : ""}
							</span>
							<span class="group-hover:underline text-blue-600">
								{getNoteTitle(note)}
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Option B: Multi-select Pills -->
		<div class="mb-16" id="option-b">
			<h2 class="text-lg font-bold mb-4 text-gray-400 border-b pb-2">Option B: Multi-select Pills</h2>
			<div class="mb-4">
				<span class="text-sm text-gray-500 mr-2">Filter:</span>
				<span id="selected-tags-b" class="inline-flex gap-2 flex-wrap"></span>
				<div class="relative inline-block ml-2">
					<button id="add-tag-btn-b" class="px-3 py-1 text-sm font-mono rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200">
						+ Add tag
					</button>
					<div id="tag-dropdown-b" class="hidden absolute top-full left-0 mt-1 bg-white border rounded shadow-lg z-10 max-h-48 overflow-y-auto">
						{sortedTags.map(({ tag, count }) => (
							<button
								class="dropdown-tag-b block w-full text-left px-3 py-1 text-sm font-mono hover:bg-gray-100"
								data-tag={tag}
							>
								{tag} <span class="text-gray-400">({count})</span>
							</button>
						))}
					</div>
				</div>
			</div>
			<p class="text-sm text-gray-500 mb-2" id="count-b">Showing all {sortedNotes.length} notes</p>
			<ul class="font-mono text-sm space-y-1" id="notes-b">
				{sortedNotes.slice(0, 15).map((note) => (
					<li data-tags={JSON.stringify(note.data.tags || [])}>
						<a href={`/${note.collection}/${note.slug}/`} class="flex items-baseline group">
							<span class="text-gray-400 mr-4 shrink-0">
								{note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : ""}
							</span>
							<span class="group-hover:underline text-blue-600">
								{getNoteTitle(note)}
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Option D: Multi-select Tag Bar -->
		<div class="mb-16" id="option-d">
			<h2 class="text-lg font-bold mb-4 text-gray-400 border-b pb-2">Option D: Multi-select Tag Bar</h2>
			<div class="flex flex-wrap gap-2 mb-4" id="tagbar-d">
				<button
					class="tag-btn-d-all px-3 py-1 text-sm font-mono rounded-full bg-blue-100 text-blue-700"
					data-tag="all"
				>
					All
				</button>
				{sortedTags.map(({ tag, count }) => (
					<button
						class="tag-btn-d px-3 py-1 text-sm font-mono rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200"
						data-tag={tag}
					>
						{tag} <span class="text-gray-400">({count})</span>
					</button>
				))}
			</div>
			<p class="text-sm text-gray-500 mb-2" id="count-d">Showing all {sortedNotes.length} notes</p>
			<ul class="font-mono text-sm space-y-1" id="notes-d">
				{sortedNotes.slice(0, 15).map((note) => (
					<li data-tags={JSON.stringify(note.data.tags || [])}>
						<a href={`/${note.collection}/${note.slug}/`} class="flex items-baseline group">
							<span class="text-gray-400 mr-4 shrink-0">
								{note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : ""}
							</span>
							<span class="group-hover:underline text-blue-600">
								{getNoteTitle(note)}
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Option C: Sidebar Facets -->
		<div class="mb-16" id="option-c">
			<h2 class="text-lg font-bold mb-4 text-gray-400 border-b pb-2">Option C: Sidebar Facets</h2>
			<div class="flex gap-8">
				<div class="w-48 shrink-0">
					<div class="text-xs text-gray-400 uppercase tracking-wider mb-2">Tags</div>
					<div class="space-y-1" id="facets-c">
						{sortedTags.slice(0, 12).map(({ tag, count }) => (
							<label class="flex items-center gap-2 text-sm font-mono cursor-pointer hover:bg-gray-50 px-1 rounded">
								<input type="checkbox" class="facet-cb-c" data-tag={tag} />
								<span class="flex-1">{tag}</span>
								<span class="text-gray-400">({count})</span>
							</label>
						))}
					</div>
				</div>
				<div class="flex-1">
					<p class="text-sm text-gray-500 mb-2" id="count-c">Showing all {sortedNotes.length} notes</p>
					<ul class="font-mono text-sm space-y-1" id="notes-c">
						{sortedNotes.slice(0, 15).map((note) => (
							<li data-tags={JSON.stringify(note.data.tags || [])}>
								<a href={`/${note.collection}/${note.slug}/`} class="flex items-baseline group">
									<span class="text-gray-400 mr-4 shrink-0">
										{note.data.created ? new Date(note.data.created).toISOString().slice(0, 10) : ""}
									</span>
									<span class="group-hover:underline text-blue-600">
										{getNoteTitle(note)}
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>

	</section>
</BaseLayout>

<script define:vars={{ notesData, IGNORED_TAGS }}>
	// Option A: Tag Bar (single select)
	document.querySelectorAll('.tag-btn-a').forEach(btn => {
		btn.addEventListener('click', () => {
			const tag = btn.dataset.tag;
			document.querySelectorAll('.tag-btn-a').forEach(b => {
				b.classList.remove('active', 'bg-blue-100', 'text-blue-700');
				b.classList.add('bg-gray-100', 'text-gray-600');
			});
			btn.classList.add('active', 'bg-blue-100', 'text-blue-700');
			btn.classList.remove('bg-gray-100', 'text-gray-600');

			document.querySelectorAll('#notes-a li').forEach(li => {
				const tags = JSON.parse(li.dataset.tags || '[]');
				if (tag === 'all' || tags.includes(tag)) {
					li.style.display = '';
				} else {
					li.style.display = 'none';
				}
			});
		});
	});

	// Option B: Multi-select Pills
	const selectedTagsB = new Set();
	const dropdownB = document.getElementById('tag-dropdown-b');
	const addBtnB = document.getElementById('add-tag-btn-b');

	addBtnB.addEventListener('click', () => {
		dropdownB.classList.toggle('hidden');
	});

	document.addEventListener('click', (e) => {
		if (!addBtnB.contains(e.target) && !dropdownB.contains(e.target)) {
			dropdownB.classList.add('hidden');
		}
	});

	function updateFilterB() {
		const container = document.getElementById('selected-tags-b');
		container.innerHTML = '';
		selectedTagsB.forEach(tag => {
			const pill = document.createElement('span');
			pill.className = 'inline-flex items-center gap-1 px-2 py-1 text-sm font-mono rounded-full bg-blue-100 text-blue-700';
			pill.innerHTML = `${tag} <button class="remove-tag-b hover:text-blue-900" data-tag="${tag}">&times;</button>`;
			container.appendChild(pill);
		});

		let visibleCount = 0;
		document.querySelectorAll('#notes-b li').forEach(li => {
			const tags = JSON.parse(li.dataset.tags || '[]');
			if (selectedTagsB.size === 0 || tags.some(t => selectedTagsB.has(t))) {
				li.style.display = '';
				visibleCount++;
			} else {
				li.style.display = 'none';
			}
		});

		document.getElementById('count-b').textContent = selectedTagsB.size === 0
			? `Showing all ${notesData.length} notes`
			: `Showing ${visibleCount} notes matching selected tags`;

		container.querySelectorAll('.remove-tag-b').forEach(btn => {
			btn.addEventListener('click', () => {
				selectedTagsB.delete(btn.dataset.tag);
				updateFilterB();
			});
		});
	}

	document.querySelectorAll('.dropdown-tag-b').forEach(btn => {
		btn.addEventListener('click', () => {
			selectedTagsB.add(btn.dataset.tag);
			dropdownB.classList.add('hidden');
			updateFilterB();
		});
	});

	// Option D: Multi-select Tag Bar
	const selectedTagsD = new Set();

	function updateFilterD() {
		const allBtn = document.querySelector('.tag-btn-d-all');

		// Update "All" button state
		if (selectedTagsD.size === 0) {
			allBtn.classList.add('bg-blue-100', 'text-blue-700');
			allBtn.classList.remove('bg-gray-100', 'text-gray-600');
		} else {
			allBtn.classList.remove('bg-blue-100', 'text-blue-700');
			allBtn.classList.add('bg-gray-100', 'text-gray-600');
		}

		// Update tag button states
		document.querySelectorAll('.tag-btn-d').forEach(btn => {
			if (selectedTagsD.has(btn.dataset.tag)) {
				btn.classList.add('bg-blue-100', 'text-blue-700');
				btn.classList.remove('bg-gray-100', 'text-gray-600');
			} else {
				btn.classList.remove('bg-blue-100', 'text-blue-700');
				btn.classList.add('bg-gray-100', 'text-gray-600');
			}
		});

		// Filter notes
		let visibleCount = 0;
		document.querySelectorAll('#notes-d li').forEach(li => {
			const tags = JSON.parse(li.dataset.tags || '[]');
			if (selectedTagsD.size === 0 || tags.some(t => selectedTagsD.has(t))) {
				li.style.display = '';
				visibleCount++;
			} else {
				li.style.display = 'none';
			}
		});

		document.getElementById('count-d').textContent = selectedTagsD.size === 0
			? `Showing all ${notesData.length} notes`
			: `Showing ${visibleCount} notes matching selected tags`;
	}

	// "All" button clears selection
	document.querySelector('.tag-btn-d-all').addEventListener('click', () => {
		selectedTagsD.clear();
		updateFilterD();
	});

	// Tag buttons toggle selection
	document.querySelectorAll('.tag-btn-d').forEach(btn => {
		btn.addEventListener('click', () => {
			const tag = btn.dataset.tag;
			if (selectedTagsD.has(tag)) {
				selectedTagsD.delete(tag);
			} else {
				selectedTagsD.add(tag);
			}
			updateFilterD();
		});
	});

	// Option C: Sidebar Facets
	function updateFilterC() {
		const selectedTags = Array.from(document.querySelectorAll('.facet-cb-c:checked')).map(cb => cb.dataset.tag);

		let visibleCount = 0;
		document.querySelectorAll('#notes-c li').forEach(li => {
			const tags = JSON.parse(li.dataset.tags || '[]');
			if (selectedTags.length === 0 || tags.some(t => selectedTags.includes(t))) {
				li.style.display = '';
				visibleCount++;
			} else {
				li.style.display = 'none';
			}
		});

		document.getElementById('count-c').textContent = selectedTags.length === 0
			? `Showing all ${notesData.length} notes`
			: `Showing ${visibleCount} notes matching selected tags`;
	}

	document.querySelectorAll('.facet-cb-c').forEach(cb => {
		cb.addEventListener('change', updateFilterC);
	});
</script>
